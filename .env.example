# ==============================================================================
# PeakTix Production & Local Configuration
# ==============================================================================

# Backend Port (Render automatically sets this, defaults to 3001)
PORT=3001

# Node Environment
NODE_ENV=production

# SQLite database path (default: ./data/peaktix.db)
DB_PATH=./data/peaktix.db

# Server session secret key (Required in production: at least 32 characters)
SESSION_SECRET=change_this_to_a_random_32_character_string_for_production

# Frontend URL (e.g. https://your-peaktix.vercel.app)
CLIENT_URL=https://your-peaktix.vercel.app

# Set to true when backend and frontend are hosted on separate domains
CROSS_SITE=true

# Frontend Vite API base URL (Used during Vite build on Vercel)
# Point this to your live Render backend URL, e.g. https://peaktix-backend.onrender.com
VITE_API_URL=https://peaktix-backend.onrender.com

